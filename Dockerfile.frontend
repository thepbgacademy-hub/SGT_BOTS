FROM node:22-alpine AS builder
WORKDIR /app

ARG LEGACY_FRONTEND_JS_ALIASES=""
ARG LEGACY_FRONTEND_CSS_ALIASES=""

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts

RUN corepack enable
RUN pnpm install --frozen-lockfile
RUN pnpm --filter ./apps/telegram-miniapp build
RUN chmod +x /app/scripts/create-frontend-asset-aliases.sh
RUN LEGACY_FRONTEND_JS_ALIASES="$LEGACY_FRONTEND_JS_ALIASES" \
  LEGACY_FRONTEND_CSS_ALIASES="$LEGACY_FRONTEND_CSS_ALIASES" \
  /app/scripts/create-frontend-asset-aliases.sh /app/apps/telegram-miniapp/dist

FROM nginx:1.27-alpine
COPY apps/telegram-miniapp/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/telegram-miniapp/dist /usr/share/nginx/html

EXPOSE 8080
